# Copy to .env and fill in. Nothing here is read from anywhere else.

# --- fetching (in fallback order) ---
# Jina: optional, works without a key at a lower rate limit.
JINA_API_KEY=
# DataForSEO: optional, paid; left blank the fetch skips to a direct request.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- extraction (required) ---
OPENROUTER_API_KEY=

# --- Postgres (standard libpq variables, see schema.sql) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=crm
PGUSER=
PGPASSWORD=

# --- operator's rules (comma-separated, all optional) ---
# Your own domains: never a lead, dropped at dedupe time.
OWN_DOMAINS=example.com
# Markets you do not sell into. Country names as extraction writes them;
# a company placed there is inserted as do_not_contact.
EXCLUDED_COUNTRIES=
# Domain suffixes (ccTLDs, national free-mail providers) dropped before enrichment.
EXCLUDED_DOMAINS=
# Your market segments -- the tags the model may assign to "market".
MARKET_TAGS=region_a,region_b,region_c
